# Підключення до PostgreSQL (сервіс db з docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/support

# LLM: OpenAI-сумісний API. Порожній LLM_API_KEY → режим без ключа (статична відповідь)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=60
LLM_RPM=60
LLM_CONCURRENCY=4
# Затримка відповіді в режимі без ключа, с (для тестів можна 0)
STUB_DELAY_MIN_S=5
STUB_DELAY_MAX_S=30

# Пароль HTTP Basic Auth для /ui (логін довільний); порожньо — без автентифікації
OPERATOR_PASSWORD=

# Таймаут запиту до хелпдеску при надсиланні відповіді, с
HELPDESK_TIMEOUT_S=10
# Мок хелпдеску: частка відповідей 500 і частка «повільних» (прийнято, але довше за таймаут)
MOCK_FAIL_RATE=0
MOCK_SLOW_RATE=0
